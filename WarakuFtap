-- Tabs and sections share the same element builder as embedded mini panels.
local function makeBuilder(columns, group)
    local builder = {Container = group}
    function builder:AddControl(kind, options, side)
        local column = side == "right" and 2 or side == "left" and 1 or side or 1
        assert(column == 1 or column == 2, "Side must be left/right or 1/2")
        return api:AddControl(kind, options or {}, column, group or columns[column])
    end
    local kinds = {Toggle="toggle", Slider="slider", Dropdown="dropdown", MultiDropdown="multidropdown",
        Input="input", Button="button", ColorPicker="color", Label="label", Select="select", Swatch="swatch"}
    for name, kind in pairs(kinds) do
        builder["Add" .. name] = function(self, options, side) return self:AddControl(kind, options, side) end
    end
    function builder:AddSection(options, side)
        assert(not destroyed and not unloading, "Window is unavailable")
        if type(options) == "string" then options = {name = options} end
        options = options or {}
        side = options.side or side or "left"
        local column = side == "right" and 2 or side == "left" and 1 or side
        assert(column == 1 or column == 2, "Side must be left/right or 1/2")
        local parent = group or columns[column]
        local container = new("Frame", parent, {
            Name = "Section_" .. (options.name or "Section"), BackgroundTransparency = 1,
            Size = UDim2.fromOffset(242, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BorderSizePixel = 0, LayoutOrder = ord(parent),
        })
        new("UIListLayout", container, {Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder})
        local heading = section(container, options.name or "Section")
        local result = makeBuilder(columns, container)
        result.Frame = container
        function result:SetTitle(value) heading:FindFirstChild("Title").Text = tostring(value); return self end
        function result:SetVisible(value) container.Visible = value == true; return self end
        return result
    end
    return builder
end
