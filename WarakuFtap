local function pruneSearch(active)
    local count, candidates = 0, {}
    for key, entry in pairs(searchEntries) do
        count = count + 1
        if not active or (not resultItems[key]:GetAttribute("Matched") and not resultItems[key].Visible) then candidates[#candidates + 1] = {key=key, touched=entry.touched} end
    end
    table.sort(candidates, function(a,b) return a.touched < b.touched end)
    local limit = windowOptions.searchCacheLimit or 32
    for _, candidate in ipairs(candidates) do
        if count <= limit then break end
        local key = candidate.key
        local entry = searchEntries[key]
        searchEntries[key] = nil; resultItems[key] = nil
        entry.scope:Destroy(); count = count - 1
    end
end
