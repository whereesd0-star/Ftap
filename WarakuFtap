-- Fetch asynchronously; the menu remains usable if client HTTP is unavailable.
-- Only asset IDs and crop coordinates are parsed; remote source is never executed.
rootScope:Spawn(function()
    local now = os.time()
    if iconCache.loading or (iconCache.retryAt or 0) > now then return end
    if iconCache.fetched and now - (iconCache.fetchedAt or now) < 3600 then return end
    requestToken = {}; iconCache.requestToken = requestToken
    iconCache.loading = true
    local ok, source = pcall(function() return HttpService:GetAsync(ICON_URL) end)
    if not ok then ok, source = pcall(function() return game:HttpGet(ICON_URL) end) end
    if rootScope.disposed or iconCache.requestToken ~= requestToken then return end
    iconCache.loading = false; iconCache.requestToken = nil
    if not ok or type(source) ~= "string" or #source > 1000000 then iconCache.retryAt = os.time() + 30; return end
    local sheets = {}
    for id, assetId in source:gmatch('%["(%d+)"%]%s*=%s*"rbxassetid://(%d+)"') do sheets[tonumber(id)] = assetId end
    for alias, name in pairs(iconNames) do
        local body = source:match('%["' .. name:gsub("%-", "%%-") .. '"%]%s*=%s*{(.-)}')
        if body then
            local x, y = body:match("ImageRectPosition%s*=%s*Vector2%.new%(%s*(%d+)%s*,%s*(%d+)%s*%)")
            local w, h = body:match("ImageRectSize%s*=%s*Vector2%.new%(%s*(%d+)%s*,%s*(%d+)%s*%)")
            local id = tonumber(body:match("Image%s*=%s*(%d+)"))
            if x and w and sheets[id] and tonumber(w) > 0 and tonumber(h) > 0 then
                icons[alias] = {sheets[id], {tonumber(w), tonumber(h)}, {tonumber(x), tonumber(y)}}
            end
        end
    end
    iconCache.icons = icons; iconCache.fetched = true; iconCache.fetchedAt = os.time(); iconCache.retryAt = nil
    preloadIcons()
    if gui and not destroyed then
