function Library:CreateWindow(options)
    assert(options == nil or type(options) == "table", "Window options must be a table")
    local config = {}
    for key, value in pairs(options or {}) do config[key] = value end
    windowSerial = windowSerial + 1
    config.id = config.id or ("SourceUI_" .. windowSerial)
    assert(type(config.id) == "string" and #config.id > 0, "Window id must be a non-empty string")
    assert(config.title == nil or type(config.title) == "string", "Window title must be text")
    assert(config.searchCacheLimit == nil or type(config.searchCacheLimit) == "number" and config.searchCacheLimit >= 0 and config.searchCacheLimit <= 128 and config.searchCacheLimit % 1 == 0, "searchCacheLimit must be 0..128")
    assert(config.open == nil or type(config.open) == "boolean", "Window open must be boolean")
    assert(config.motionSpeed == nil or type(config.motionSpeed) == "number" and config.motionSpeed >= 0.25 and config.motionSpeed <= 3, "Motion speed must be 0.25..3")
    assert(config.keybind == nil or typeof(config.keybind) == "EnumItem" and config.keybind.EnumType == Enum.KeyCode, "Use Enum.KeyCode")
    for _, key in ipairs({"logo", "avatar", "fontFamily"}) do assert(config[key] == nil or type(config[key]) == "string", key .. " must be text") end
    if config.theme then
        assert(type(config.theme) == "table", "Theme must be a table")
        local allowed = {bg=true,panel=true,row=true,rowHover=true,box=true,text=true,inactive=true,accent=true,stroke=true,label=true,title=true}
        for name, color in pairs(config.theme) do
            assert(allowed[name] and typeof(color) == "Color3", "Invalid theme token: " .. tostring(name))
            for _, channel in ipairs({color.R, color.G, color.B}) do assert(channel >= 0 and channel <= 1, "Color channels must be finite and 0..1") end
        end
    end
    if config.title then checkedPreferences({title=config.title}) end
    if config.preferences ~= nil then config.preferences = checkedPreferences(config.preferences) end
    if config.layout ~= nil then config.layout = checkedLayout(config.layout) end
    local window = createWindow(config)
    windows[window] = true
    return window
end
function Library:Destroy()
    for window in pairs(windows) do window:Destroy() end
    table.clear(windows)
end
return Library
