local function preloadIcons()
    local ok, provider = pcall(function() return game:GetService("ContentProvider") end)
    if not ok then return end
    local assets = {}
    for _, data in pairs(icons) do
        local uri = "rbxassetid://" .. data[1]
        if not iconCache.assets[uri] then
            local token = {}; pendingAssets[uri] = token; iconCache.assets[uri] = token
            assets[#assets + 1] = uri
        end
    end
    if #assets == 0 then return end
    local loaded = pcall(function()
        provider:PreloadAsync(assets, function(uri, status)
            if rootScope.disposed then return end
            iconCache.assets[uri] = status == Enum.AssetFetchStatus.Success and true or nil
            iconCache.assetTimes[uri] = os.time(); pendingAssets[uri] = nil
        end)
    end)
    if not loaded then for _, uri in ipairs(assets) do iconCache.assets[uri] = nil; pendingAssets[uri] = nil end end
    local entries = {}
    for uri, timestamp in pairs(iconCache.assetTimes) do entries[#entries+1] = {uri, timestamp} end
    table.sort(entries, function(a,b) return a[2] < b[2] end)
    for i=1, math.max(0, #entries - 16) do
        local uri = entries[i][1]; iconCache.assets[uri] = nil; iconCache.assetTimes[uri] = nil
    end
end
