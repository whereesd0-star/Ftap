local navigation = new("ScrollingFrame", root, {
    Name = "TabList", Position = UDim2.fromOffset(6, 60), Size = UDim2.fromOffset(50, 224),
    BackgroundTransparency = 1, BorderSizePixel = 0, CanvasSize = UDim2.new(),
    ScrollBarThickness = 1, ScrollBarImageTransparency = 0.7, ScrollBarImageColor3 = C.accent,
    ScrollingDirection = Enum.ScrollingDirection.Y,
})
local marker = useAccent(rect(root, "ActiveTab", 7, 299, 3, 16, C.accent, "full"))
local tabs = {}
local function styleTab(i, selected, animated)
    local tab = tabs[i]
    if not tab then return end
    local t = animated and 0.2 or 0
    tween(tab.image, t, {ImageColor3 = selected and C.accent or tab.hovered and titleColor or C.inactive})
    tween(tab.tile, t, {BackgroundColor3 = selected and C.bg or tab.hovered and C.rowHover or C.panel})
end
local function moveMarker(index, animated)
    local page = pages[index + 1]
    local host = page.isSettings and root or navigation
    local position = page.isSettings and UDim2.fromOffset(7, 299) or UDim2.fromOffset(1, 11 + index * 38)
    if marker.Parent ~= host then marker.Parent = host; marker.Position = position end
    tween(marker, animated and 0.26 or 0, {Position = position})
    if not page.isSettings then
        local y = 4 + index * 38
        local top = navigation.CanvasPosition.Y
        if y < top then navigation.CanvasPosition = Vector2.new(0, y)
        elseif y + 30 > top + 224 then navigation.CanvasPosition = Vector2.new(0, y + 30 - 224) end
    end
end
local function rebuildTabs()
    table.clear(tabs)
    api.Tabs = {}
    for index, page in ipairs(pages) do
        if not page.tab then
            local tile = rect(page.isSettings and root or navigation, "Tab_" .. page.title, 0, 0, 30, 30, C.panel, 10)
            local image = icons[page.icon or "target"] and icon(tile, page.icon or "target", 5, 5, 20, C.inactive)
                or asset(tile, "CustomIcon", page.icon, "target", 5, 5, 20, 20)
            page.tab = {tile = tile, image = image}
            local select = hit(tile, "Select", 0, 0, 30, 30)
            connect(select.Activated, function() api:SelectTab(table.find(pages, page) - 1) end)
            connect(select.MouseEnter, function()
                page.tab.hovered = true
                local i = table.find(pages, page); styleTab(i, api.Tab == i - 1, true)
            end)
            connect(select.MouseLeave, function()
                page.tab.hovered = false
                local i = table.find(pages, page); styleTab(i, api.Tab == i - 1, true)
            end)
        end
        page.tab.tile.Position = page.isSettings and UDim2.fromOffset(17, 292) or UDim2.fromOffset(11, 4 + (index - 1) * 38)
        tabs[index] = page.tab
        api.Tabs[page.title] = index - 1
    end
    navigation.CanvasSize = UDim2.fromOffset(0, math.max(224, (#pages - 1) * 38 + 8))
    api.Tab = selectedPage and (table.find(pages, selectedPage) or 1) - 1 or 0
    for i = 1, #tabs do styleTab(i, i - 1 == api.Tab, false) end
    moveMarker(api.Tab, false)
end
registerRefresher(function()
    for i = 1, #tabs do styleTab(i, i - 1 == api.Tab, true) end
end)

