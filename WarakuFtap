                    v = nv
                end
                saturation.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromHSV(h, 1, 1))
                tween(cursor, animated and 0.06 or 0, {Position = UDim2.fromOffset(5 + s * 204, 5 + (1 - v) * 84), BackgroundColor3 = color})
                tween(hueMarker, animated and 0.06 or 0, {Position = UDim2.fromOffset(4 + h * 206, 6), BackgroundColor3 = Color3.fromHSV(h, 1, 1)})
                tween(newPreview, animated and 0.10 or 0, {BackgroundColor3 = color})
                if force or not hex:IsFocused() then write(hex, "#" .. color:ToHex():upper()) end
                local values = {color.R, color.G, color.B}
                for i, box in ipairs(channels) do
                    if force or not box:IsFocused() then write(box, tostring(math.floor(values[i] * 255 + 0.5))) end
                end
            end
            local function applyColor(color, origin)
                inputOrigin = origin
                api:Set(d.key, color)
                inputOrigin = nil
                refresh(true, origin == "hsv", false)
            end
            local function invalid(edge)
                edge.Color = Color3.fromRGB(225, 105, 105)
                tween(edge, 0.35, {Color = C.stroke})
            end
            local function editHex(final)
                local value = hex.Text:match("^%s*#?(%x+)%s*$")
                if value and #value == 3 then value = value:gsub("(.)", "%1%1") end
                if value and #value == 6 then
                    applyColor(Color3.fromHex(value), "text")
                elseif final then invalid(hexStroke) end
                if final then write(hex, "#" .. api.State[d.key]:ToHex():upper()) end
            end
            local function editRGB(index, final)
                local box = channels[index]
                local number = tonumber(box.Text)
                local valid = number and number == number and math.abs(number) < math.huge
                if valid and (final or (number >= 0 and number <= 255 and number % 1 == 0)) then
                    number = math.clamp(math.floor(number + 0.5), 0, 255)
                    local color = api.State[d.key]
                    local values = {math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5)}
                    values[index] = number
                    applyColor(Color3.fromRGB(values[1], values[2], values[3]), "text")
                elseif final then invalid(channelStrokes[index]) end
                if final then
                    local color = api.State[d.key]
                    local values = {color.R, color.G, color.B}
                    write(box, tostring(math.floor(values[index] * 255 + 0.5)))
                end
            end
            flush = function()
                local focused = Input:GetFocusedTextBox()
                if focused == hex then editHex(true)
                else
                    for i, box in ipairs(channels) do if focused == box then editRGB(i, true); break end end
                end
                if focused == hex or table.find(channels, focused) then focused:ReleaseFocus() end
            end
            listen(hex:GetPropertyChangedSignal("Text"), function()
                if hex:IsFocused() and hex.Text ~= written[hex] then editHex(false) end
            end)
            editors[hex] = function() editHex(true) end
            listen(hex.FocusLost, editors[hex])
            for i, box in ipairs(channels) do
                listen(box:GetPropertyChangedSignal("Text"), function()
                    if box:IsFocused() and box.Text ~= written[box] then editRGB(i, false) end
                end)
                editors[box] = function() editRGB(i, true) end
                listen(box.FocusLost, editors[box])
            end
            local function bindArea(area, update, extra)
                local button = hit(area, "Drag", 0, -(extra or 0), area.Size.X.Offset, area.Size.Y.Offset + 2 * (extra or 0))
                button.ZIndex = 4
                listen(button.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        flush()
                        activePicker = {input = input, update = update}; update(input.Position)
                    end
                end)
            end
            bindArea(square, function(position)
                local sx = square.AbsoluteSize.X / 214
                local sy = square.AbsoluteSize.Y / 94
                s = math.clamp((position.X - square.AbsolutePosition.X - 5 * sx) / math.max(1, 204 * sx), 0, 1)
                v = 1 - math.clamp((position.Y - square.AbsolutePosition.Y - 5 * sy) / math.max(1, 84 * sy), 0, 1)
                applyColor(Color3.fromHSV(h, s, v), "hsv")
            end)
            bindArea(hue, function(position)
                local factor = hue.AbsoluteSize.X / 214
                h = math.clamp((position.X - hue.AbsolutePosition.X - 4 * factor) / math.max(1, 206 * factor), 0, 1)
                applyColor(Color3.fromHSV(h, s, v), "hsv")
            end, 5)
            listen(reset.Activated, function()
                inputOrigin = nil
                api:Set(d.key, original)
                h, s, v = original:ToHSV()
                refresh(true, true, true)
            end)
            -- State syncs run synchronously, unlike deferred BindableEvent listeners.
            local function modelSync(animated) refresh(animated, inputOrigin == "hsv", inputOrigin == nil) end
            registerSync(d.key, modelSync)
            refresh(false, false, true)
            return {
                commit = flush,
                dispose = function()
                    editors[hex] = nil
                    for _, box in ipairs(channels) do editors[box] = nil end
                    local index = table.find(syncs[d.key], modelSync)
                    if index then table.remove(syncs[d.key], index) end
                end,
            }
        end)
    end)
    return frame
end

