function api:SetOpen(open)
    if destroyed or unloading then return end
    assert(type(open) == "boolean", "Open must be a boolean")
    if self.Open == open then return end
    commitFocusedEditor(true)
    closePopup()
    closeMini()
    self.Open = open
    if positionFollowers[root] then root.Position = positionFollowers[root]; positionFollowers[root] = nil end
    openRevision = openRevision + 1
    local revision = openRevision
    customization:CancelDrag()
    if activeSlider then
        tween(activeSlider.knob, 0.12, {Size = UDim2.fromOffset(14, 14)})
        activeSlider = nil
    end
    if not open then search:ReleaseFocus() end
    winVeil.Visible = true
    drawWindow()
    root.Visible = true
    local target = open and 1 or 0
    local duration = math.max(0.06, (open and 0.24 or 0.18) * math.abs(target - openness.Value))
    -- The helper cancels the previous tween before starting from its current value.
    local animation = tween(openness, duration, {Value = target}, Enum.EasingStyle.Quad)
    local finished
    finished = rootScope:Connect(animation.Completed, function(state)
        rootScope:Disconnect(finished)
        if destroyed or revision ~= openRevision or state ~= Enum.PlaybackState.Completed then return end
        root.Visible = self.Open
        winVeil.Visible = false
    end)
end

