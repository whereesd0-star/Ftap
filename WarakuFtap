-- Popups live above clipped pages; listeners are disposed on every close.
closePopup = function(immediate)
    local current = popup.current
    if not current or current.closing then return end
    current.closing = true
    if current.commit then current.commit() end
    popup.current = nil; popup.anchor = nil; activePicker = nil
    if current.dispose then current.dispose() end
    if current.onClose then current.onClose() end
    if immediate or destroyed then
        current.scope:Destroy()
    else
        closingPopups[current] = true
        afterTween(tween(current.panel, 0.12, {FadeTransparency = 1}), function()
            closingPopups[current] = nil; current.scope:Destroy()
        end)
    end
end
openPopup = function(anchor, width, height, build, onClose)
    if customization.CancelDrag then customization:CancelDrag() end
    if destroyed or unloading or not api.Open then return end
    closePopup(true)
    for old in pairs(closingPopups) do closingPopups[old] = nil; old.scope:Destroy() end
    local previousScope = currentScope
    local owner = Scope.new(rootScope); currentScope = owner
    local factor = math.max(0.01, root.AbsoluteSize.X / 600)
    local relative = (anchor.AbsolutePosition - root.AbsolutePosition) / factor
    local x = math.clamp(relative.X, 8, 600 - width - 8)
    local y = relative.Y + anchor.AbsoluteSize.Y / factor + 5
    if y + height > 362 then y = math.max(8, relative.Y - height - 5) end
    local overlay = hit(root, "PopupOverlay", 0, 0, 600, 370)
    overlay.ZIndex = 120
    owner:Own(overlay)
    local panel = new("Frame", overlay, {
        Name = "Popup", Position = UDim2.fromOffset(x, y + 4), Size = UDim2.fromOffset(width, height),
        BackgroundColor3 = C.panel, BorderSizePixel = 0, FadeTransparency = 1, ZIndex = 2,
    })
    new("UICorner", panel, {CornerRadius = UDim.new(0, 10)})
    local edge = rect(panel, "Border", 1, 1, width - 2, height - 2, C.panel, 9)
    tween(edge, 0, {BackgroundTransparency = 1}); edge.ZIndex = 10
    stroke(edge, C.stroke, 0)
    -- Sink clicks on the panel itself instead of forwarding them to the overlay.
    local panelHit = hit(panel, "PanelHit", 0, 0, width, height)
    panelHit.ZIndex = 0
    local record = {overlay = overlay, panel = panel, scope = owner, onClose = onClose}
    popup.current = record; popup.anchor = anchor
    local function listen(signal, callback)
        return owner:Connect(signal, function(...)
            if popup.current == record and not destroyed and not record.closing then callback(...) end
        end)
    end
    local function close() if popup.current == record then closePopup() end end
    listen(overlay.Activated, close)
    listen(Input.InputBegan, function(input)
        if input.KeyCode == Enum.KeyCode.Escape then close() end
    end)
    local ok, lifecycle = pcall(build, panel, listen, close)
    currentScope = previousScope
    if not ok then popup.current = nil; popup.anchor = nil; owner:Destroy(); error(lifecycle, 0) end
    if type(lifecycle) == "table" then record.commit, record.dispose = lifecycle.commit, lifecycle.dispose end
    tween(panel, 0.18, {Position = UDim2.fromOffset(x, y), FadeTransparency = 0})
end

