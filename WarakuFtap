local function checkedPreferences(values)
    assert(type(values) == "table", "Preferences must be a table")
    local checked = {}
    for name, value in pairs(values) do
        local d = assert(preferenceSpecs[name], "Unknown preference: " .. tostring(name))
        assert(type(value) == type(d.value), "Wrong preference type: " .. name)
        if d.kind == "slider" then
            assert(value == value and math.abs(value) < math.huge, "Preference must be finite: " .. name)
            value = math.clamp(math.floor((value - d.min) / d.step + 0.5) * d.step + d.min, d.min, d.max)
        elseif d.kind == "input" then
            assert(utf8.len(value) and #value <= d.maxLength and not value:find("[%z\1-\31]"), "Invalid menu title")
        elseif d.kind == "dropdown" then
            assert(table.find(d.options, value), "Unknown preference option: " .. name)
        end
        checked[name] = value
    end
    return checked
end
local function checkedLayout(layout)
    assert(type(layout) == "table", "Layout must be a table")
    local checked = {}
    for name, point in pairs(layout) do
        assert(name == "window" or name == "floating", "Unknown layout position: " .. tostring(name))
        assert(type(point) == "table", "Layout position must be a table")
        for key in pairs(point) do assert(key == "x" or key == "y", "Unknown layout coordinate") end
        for _, key in ipairs({"x", "y"}) do
            assert(type(point[key]) == "number" and point[key] >= 0 and point[key] <= 1, "Layout coordinates must be finite and 0..1")
        end
        checked[name] = {x=point.x, y=point.y}
    end
    return checked
end
-- Each window, control and popup owns its resources. Disposal is idempotent.
local Scope = {}
Scope.__index = Scope
function Scope.new(parent)
    local self = setmetatable({connections={}, cleanups={}, instances={}, children={}, tasks={}, disposed=false, parent=parent}, Scope)
    if parent then parent.children[self] = true end
    return self
end
function Scope:Add(cleanup)
    if self.disposed then cleanup(); return cleanup end
    self.cleanups[cleanup] = true
    return cleanup
end
function Scope:Connect(signal, callback)
    local connection = signal:Connect(function(...)
        if not self.disposed then return callback(...) end
    end)
    self.connections[connection] = true
    return connection
end
function Scope:Disconnect(connection)
    if connection then connection:Disconnect(); self.connections[connection] = nil end
end
function Scope:Own(instance) self.instances[instance] = true; return instance end
function Scope:Forget(instance) self.instances[instance] = nil end
function Scope:Spawn(callback)
    if self.disposed then return end
    local thread = coroutine.create(function()
        local ok, message = pcall(callback)
        self.tasks[coroutine.running()] = nil
        if not ok and not self.disposed then warn("Source UI task: " .. tostring(message)) end
    end)
    self.tasks[thread] = true
    task.spawn(thread)
    return thread
end
function Scope:Destroy()
    if self.disposed then return end
    self.disposed = true
    if self.parent then self.parent.children[self] = nil; self.parent = nil end
    for connection in pairs(self.connections) do connection:Disconnect() end
    table.clear(self.connections)
    for thread in pairs(self.tasks) do
        if thread ~= coroutine.running() then pcall(task.cancel, thread) end
    end
    table.clear(self.tasks)
    for child in pairs(self.children) do child:Destroy() end
    table.clear(self.children)
    for cleanup in pairs(self.cleanups) do
        local ok, message = pcall(cleanup)
        if not ok then warn("Source UI cleanup: " .. tostring(message)) end
    end
    table.clear(self.cleanups)
    for instance in pairs(self.instances) do instance:Destroy() end
    table.clear(self.instances)
end
function Scope:Counts(result)
    result = result or {connections=0, tasks=0, scopes=0}
    if self.disposed then return result end
    result.scopes = result.scopes + 1
    for connection in pairs(self.connections) do if connection.Connected then result.connections = result.connections + 1 end end
    for _ in pairs(self.tasks) do result.tasks = result.tasks + 1 end
    for child in pairs(self.children) do child:Counts(result) end
    return result
end

