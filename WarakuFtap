-- Static alpha is a number. Tween channels are allocated only when animated.
local visuals, fades, scopeMembers = {}, {}, {}
local dirtyVisuals, dirtyScopes = {}, {}
local ensureRender
local function renderVisual(item)
    local record = visuals[item]
    if not record then return end
    local opacity = 1
    for _, frame in ipairs(record.scopes) do opacity = opacity * (1 - fades[frame].Value) end
    for key, value in pairs(record.values) do item[key] = math.clamp(1 - (1 - value) * opacity, 0, 1) end
end
local function renderTree(item)
    local members = scopeMembers[item]
    if members then
        for member in pairs(members) do renderVisual(member) end
    else
        renderVisual(item)
        for _, child in ipairs(item:GetDescendants()) do renderVisual(child) end
    end
end
local function markVisual(item)
    dirtyVisuals[item] = true
    if ensureRender then ensureRender() end
end
local function markScope(item)
    dirtyScopes[item] = true
    if ensureRender then ensureRender() end
end
local function attachVisual(item)
    local record = visuals[item]
    if not record then return end
    for _, frame in ipairs(record.scopes) do if scopeMembers[frame] then scopeMembers[frame][item] = nil end end
    table.clear(record.scopes)
    local node = item
    while node do
        if fades[node] then record.scopes[#record.scopes + 1] = node; scopeMembers[node][item] = true end
        node = node.Parent
    end
    renderVisual(item)
end
local function bindTheme(item, key, value)
    if typeof(value) ~= "Color3" then return end
    if item:GetAttribute("NoTheme") then themeBindings[item] = nil; return end
    local bindings = themeBindings[item] or {}
    local token = bindings[key]
    if not token or C[token] ~= value then
        token = nil
        for name, color in pairs(C) do if color == value then token = name; break end end
    end
    bindings[key] = token
    themeBindings[item] = bindings
end
local function new(class, container, properties)
    local item = Instance.new(class)
    local owner = currentScope
    instanceScopes[item] = owner
    if item:IsA("GuiObject") then
        item.BorderSizePixel = 0
        if noSelection then item.SelectionImageObject = noSelection end
    end
    local fade = properties and properties.FadeTransparency
    for key, value in pairs(properties or {}) do
        if key ~= "FadeTransparency" then item[key] = value; bindTheme(item, key, value) end
    end
    if class == "UICorner" and item.CornerRadius.Scale == 0 then
        customization.corners[item] = item.CornerRadius.Offset
        item.CornerRadius = UDim.new(0, item.CornerRadius.Offset * customization.roundness)
    end
    item.Parent = container
    local keys = {}
    if item:IsA("GuiObject") then keys[#keys + 1] = "BackgroundTransparency" end
    if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
        keys[#keys + 1] = "TextTransparency"; keys[#keys + 1] = "TextStrokeTransparency"
    end
    if class == "ImageLabel" or class == "ImageButton" then keys[#keys + 1] = "ImageTransparency" end
    if class == "ScrollingFrame" then keys[#keys + 1] = "ScrollBarImageTransparency" end
    if class == "UIStroke" then keys[#keys + 1] = "Transparency" end
    local record = {values={}, channels={}, scopes={}, connections={}}
    local function listen(signal, fn)
        local connection = owner:Connect(signal, fn)
        record.connections[connection] = true
        return connection
    end
    if #keys > 0 then
        visuals[item] = record
        for _, key in ipairs(keys) do record.values[key] = item[key] end
    end
    if fade ~= nil then
        local value = Instance.new("NumberValue")
        value.Value = fade; fades[item] = value; scopeMembers[item] = {}
        listen(value.Changed, function() markScope(item) end)
    end
    if #keys > 0 or fade ~= nil then
        local cleaned = false
        local cleanup
        cleanup = function()
            if cleaned then return end
            cleaned = true
            owner.cleanups[cleanup] = nil
            for connection in pairs(record.connections) do owner:Disconnect(connection) end
            if activeTweens[item] then
                for _, animation in pairs(activeTweens[item]) do animation:Cancel() end
                activeTweens[item] = nil
            end
            for _, frame in ipairs(record.scopes) do if scopeMembers[frame] then scopeMembers[frame][item] = nil end end
            for _, channel in pairs(record.channels) do channel.value:Destroy() end
            if fades[item] then fades[item]:Destroy(); fades[item] = nil; scopeMembers[item] = nil end
            visuals[item] = nil; editors[item] = nil; themeBindings[item] = nil; instanceScopes[item] = nil
            dirtyVisuals[item] = nil; dirtyScopes[item] = nil
        end
        owner:Add(cleanup)
        listen(item:GetPropertyChangedSignal("Parent"), function()
            attachVisual(item)
            for _, child in ipairs(item:GetDescendants()) do attachVisual(child) end
        end)
        listen(item.Destroying, cleanup)
        attachVisual(item)
    end
    return item
end
local function alphaChannel(inst, key)
    local record = visuals[inst]
    if not record.channels[key] then
        local value = Instance.new("NumberValue")
        value.Value = record.values[key]
        local connection = instanceScopes[inst]:Connect(value.Changed, function()
            record.values[key] = value.Value
            markVisual(inst)
        end)
        record.connections[connection] = true
        record.channels[key] = {value=value, connection=connection}
    end
    return record.channels[key].value
end
local function tween(inst, time, props, style, dir)
    time = time / motionSpeed
    local running = activeTweens[inst]
    if not running then running = {}; activeTweens[inst] = running end
    local last
    -- Independent property channels: recoloring must not cancel movement/fades.
    for key, value in pairs(props) do
        bindTheme(inst, key, value)
        if running[key] then running[key]:Cancel() end
        activeTweens[inst] = running
        local target, property = inst, key
        if key == "FadeTransparency" then
            target, property = assert(fades[inst]), "Value"
        elseif visuals[inst] and visuals[inst].values[key] then
            if time <= 0 then
                local record = visuals[inst]
                record.values[key] = value
                if record.channels[key] then record.channels[key].value.Value = value end
                renderVisual(inst)
                running[key] = nil
                target, property = nil, nil
            else
                target, property = alphaChannel(inst, key), "Value"
            end
        end
        if not target then
            -- A static alpha update does not need a NumberValue.
        elseif destroyed or time <= 0 then
            target[property] = value
            if key == "FadeTransparency" then renderTree(inst) end
            running[key] = nil
        else
            local t = TweenService:Create(target,
                TweenInfo.new(time, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
                {[property] = value})
            running[key] = t
            local done
            local owner = instanceScopes[inst] or rootScope
            done = owner:Connect(t.Completed, function()
                owner:Disconnect(done)
                if running[key] == t then running[key] = nil end
                if not next(running) and activeTweens[inst] == running then activeTweens[inst] = nil end
            end)
            t:Play()
            last = t
        end
    end
    if not next(running) then activeTweens[inst] = nil end
    return last
end
local function afterTween(animation, callback)
    if not animation then return end
    local done
    done = rootScope:Connect(animation.Completed, function(state)
        rootScope:Disconnect(done)
        if not destroyed and state == Enum.PlaybackState.Completed then callback() end
    end)
end
local positionFollowers = setmetatable({}, {__mode = "k"})
local function followPosition(inst, target)
    positionFollowers[inst] = target
