            elseif item.Visible then
                local outgoing = item
                afterTween(tween(outgoing, 0.12, {FadeTransparency = 1}), function()
                    if not outgoing:GetAttribute("Matched") then outgoing.Visible = false; pruneSearch(true) end
                end)
            end
            end
        end
        local noResults = count == 0
        if noResults then empty.Visible = true end
        afterTween(tween(empty, 0.16, {TextTransparency = noResults and 0 or 1}), function()
            if revision == filterRevision then empty.Visible = noResults end
        end)
        tween(scroll, 0.18, {CanvasSize = UDim2.fromOffset(0, count > 0 and y + rowHeight + 4 or 56), CanvasPosition = Vector2.zero})
    end
    if active then pruneSearch(true) elseif not searchPage.frame.Visible then pruneSearch(false) end
    showPage(active and searchPage or pages[api.Tab + 1], dir)
end
connect(search:GetPropertyChangedSignal("Text"), function()
    if search:GetAttribute("SelectingTab") then return end
    closePopup(); closeMini()
