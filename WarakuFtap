local function hit(container, name, x,y,w,h)
    local button = new("TextButton", container, {
        Name = name, Position = UDim2.fromOffset(x,y), Size = UDim2.fromOffset(w,h),
        BackgroundTransparency = 1, BorderSizePixel = 0, Text = "", AutoButtonColor = false,
        SelectionImageObject = noSelection,
    })
    local owner = currentScope
    local commitConnection = owner:Connect(button.Activated, function() commitFocusedEditor(true) end)
    local cleanup
    cleanup = function() owner:Disconnect(commitConnection); owner.cleanups[cleanup] = nil end
    owner:Add(cleanup)
    owner:Connect(button.Destroying, cleanup)
    return button
end
local function ord(container)
