-- accent color registry: everything that uses the accent recolors smoothly
local accentItems, refreshers = setmetatable({}, {__mode="k"}), {}
local function useAccent(inst, prop)
    prop = prop or "BackgroundColor3"
    local props = accentItems[inst] or {}
    props[prop] = true; accentItems[inst] = props
    local bindings = themeBindings[inst] or {}
    bindings[prop] = "accent"; themeBindings[inst] = bindings
    return inst
end
local function setAccent(color)
    C.accent = color
    for inst, properties in pairs(accentItems) do
        if inst.Parent then
            local props = {}
            for property in pairs(properties) do props[property] = color end
            tween(inst, 0.3, props)
            for property in pairs(properties) do themeBindings[inst][property] = "accent" end
        end
    end
    for fn in pairs(refreshers) do fn() end
end

local function asset(container, name, uri, fallback, x,y,w,h)
    if uri and uri ~= "" then
        return new("ImageLabel", container, {
            Name = name, Image = uri, BackgroundTransparency = 1,
            Position = UDim2.fromOffset(x,y), Size = UDim2.fromOffset(w,h),
            ScaleType = Enum.ScaleType.Stretch,
        })
    end
    return useAccent(icon(container, fallback, x,y,math.min(w,h),C.accent), "ImageColor3")
end

----------------------------------------------------------------------
-- settings schema
----------------------------------------------------------------------
local changed = Instance.new("BindableEvent")
local api = {State = {}, Tab = 0, Changed = changed.Event}
local defs, byKey, syncs, hooks = {}, {}, {}, {}
local batching, batchedKeys = false, {}
local themeApplying = false
local function copyValue(value)
    if type(value) ~= "table" then return value end
    local result = {}
    for key, item in pairs(value) do result[key] = copyValue(item) end
    return result
end
local function sameValue(a, b)
    if type(a) ~= "table" or type(b) ~= "table" then return a == b end
    for key, value in pairs(a) do if not sameValue(value, b[key]) then return false end end
    for key in pairs(b) do if a[key] == nil then return false end end
    return true
end
local function def(d)
    assert(type(d.key) == "string" and not byKey[d.key], "Control keys must be unique strings")
    d.value = copyValue(d.value)
    table.insert(defs, d)
    byKey[d.key] = d
    syncs[d.key] = {}
    api.State[d.key] = copyValue(d.value)
    return d
end
local function registerSync(key, callback)
    table.insert(syncs[key], callback)
    local owner = currentScope
    owner:Add(function()
        local callbacks = syncs[key]
        local index = callbacks and table.find(callbacks, callback)
        if index then table.remove(callbacks, index) end
    end)
end
local function registerRefresher(callback)
    refreshers[callback] = true
    currentScope:Add(function() refreshers[callback] = nil end)
end
