-- Persistent mini panels keep control subscriptions and values across openings.
local activeMini
closeMini = function(immediate)
    local current = activeMini
    if not current then return end
    activeMini = nil
    current.revision = current.revision + 1
    local revision = current.revision
    closePopup(immediate)
    activePicker = nil
    if activeSlider then tween(activeSlider.knob, 0.12, {Size = UDim2.fromOffset(14, 14)}); activeSlider = nil end
    if immediate then
        tween(current.frame, 0, {FadeTransparency = 1})
        current.overlay.Visible = false
    else
        afterTween(tween(current.frame, 0.16, {FadeTransparency = 1}), function()
            if current.revision == revision then current.overlay.Visible = false end
        end)
    end
end
function api:CreateMiniSettings(anchor, options)
    assert(not destroyed and not unloading, "Menu is unavailable")
    options = options or {}
