hooks.accent = function(i)
    if i == 0 then return end
    if byKey.customAccent then api:SetTheme({accent=ACCENTS[i]}) else setAccent(ACCENTS[i]) end
end
hooks.uiScale = function(v) tween(userScale, 0.24, {Value = v / 100}) end

local function normalizeValue(d, value)
    if d.kind == "color" then
        assert(typeof(value) == "Color3", "Expected Color3 for: " .. d.key)
        for _, channel in ipairs({value.R, value.G, value.B}) do
            assert(channel == channel and channel >= 0 and channel <= 1, "Color channels must be finite and 0..1")
        end
        return value
    end
    assert(type(value) == type(d.value), "Wrong value type for: " .. d.key)
    if d.kind == "slider" then
        assert(value == value and math.abs(value) < math.huge, "Setting must be finite")
        return math.clamp(math.floor((value - d.min) / d.step + 0.5) * d.step + d.min, d.min, d.max)
    elseif d.kind == "select" or d.kind == "dropdown" then
        assert(table.find(d.options, value) or (#d.options == 0 and value == ""), "Unknown option for: " .. d.key)
    elseif d.kind == "multidropdown" then
        local chosen, total = {}, 0
        for index, option in pairs(value) do
            assert(type(index) == "number" and index % 1 == 0 and index > 0, "Expected an array for: " .. d.key)
            assert(type(option) == "string" and table.find(d.options, option), "Unknown selection for: " .. d.key)
            assert(not chosen[option], "Duplicate selection for: " .. d.key)
            chosen[option] = true; total = total + 1
        end
        for i = 1, total do assert(value[i] ~= nil, "Expected a dense array for: " .. d.key) end
        local normalized = {}
        for _, option in ipairs(d.options) do if chosen[option] then normalized[#normalized + 1] = option end end
        return normalized
    elseif d.kind == "swatch" then
        assert(value % 1 == 0 and (d.colors[value] or d.allowNone and value == 0), "Unknown color index")
    elseif d.kind == "input" or d.kind == "label" then
        assert(utf8.len(value), "Text must be valid UTF-8")
        assert(#value <= (d.maxLength or 1024), "Text is too long for: " .. d.key)
        if d.key == "menuTitle" then assert(not value:find("[%z\1-\31]"), "Invalid menu title") end
    end
    return value
end
local function callHook(key)
    if not hooks[key] then return end
    local ok, message = pcall(hooks[key], copyValue(api.State[key]))
    if not ok then warn("Source UI callback (" .. key .. "): " .. tostring(message)) end
end
function api:Set(key, value)
    if destroyed or unloading then return end
    local d = assert(byKey[key], "Unknown setting: " .. tostring(key))
    value = normalizeValue(d, value)
    if sameValue(self.State[key], value) then return end
    self.State[key] = copyValue(value)
    for _, fn in ipairs(syncs[key]) do fn(true) end
    callHook(key)
    if batching then batchedKeys[key] = true else changed:Fire(key, copyValue(self.State[key])) end
end
function api:Get(key)
    assert(byKey[key], "Unknown setting: " .. tostring(key))
    return copyValue(self.State[key])
end
function api:SetOptions(key, options)
    if destroyed or unloading then return end
    assert(type(options) == "table", "Options must be an array")
    local d = assert(byKey[key], "Unknown setting: " .. tostring(key))
    assert(d.kind == "dropdown" or d.kind == "multidropdown", "Only dropdown controls support SetOptions")
    local checked, used = {}, {}
    local count = 0
    for index in pairs(options) do
        assert(type(index) == "number" and index > 0 and index % 1 == 0, "Options must be a dense array")
        count = count + 1
    end
    assert(count <= 100, "Use at most 100 options")
    for i = 1, count do assert(options[i] ~= nil, "Options must be a dense array") end
    for _, option in ipairs(options) do
        assert(type(option) == "string" and not used[option], "Options must be unique strings")
        used[option] = true; checked[#checked + 1] = option
    end
    closePopup()
    d.options = checked
    if d.kind == "multidropdown" then
        local defaults = {}
        for _, option in ipairs(d.value) do if used[option] then defaults[#defaults + 1] = option end end
        d.value = defaults
    elseif not used[d.value] then
        d.value = checked[1] or ""
    end
    local value = self:Get(key)
    if d.kind == "multidropdown" then
        local kept = {}
        for _, option in ipairs(value) do if used[option] then kept[#kept + 1] = option end end
        self:Set(key, kept)
    else
        self:Set(key, used[value] and value or checked[1] or "")
    end
    for _, sync in ipairs(syncs[key]) do sync(true) end
end
function api:ExportConfig()
    commitFocusedEditor(false)
    local values = {}
    for _, d in ipairs(defs) do
        if not d.transient then
            local value = self:Get(d.key)
            values[d.key] = d.kind == "color" and {type = "Color3", hex = value:ToHex()} or value
        end
    end
    local theme = {}
    for name, color in pairs(C) do theme[name] = color:ToHex() end
    local json = HttpService:JSONEncode({format = "SourceMenu", version = 1, values = values, theme = theme, keybind = menuKey.Name, layout = self:GetLayout()})
    assert(#json <= 131072, "Config exceeds 128 KiB; reduce long input values")
    return json
end
function api:ImportConfig(json)
    if destroyed or unloading then return false, "Menu is unavailable" end
    local ok, result = pcall(function()
        assert(type(json) == "string" and #json <= 131072, "Config exceeds 128 KiB")
        local data = HttpService:JSONDecode(json)
        assert(type(data) == "table" and data.format == "SourceMenu" and data.version == 1, "Unsupported config format")
        assert(type(data.values) == "table", "Missing config values")
        local pending = {}
        for key, value in pairs(data.values) do
            local d = assert(byKey[key], "Unknown setting: " .. tostring(key))
            assert(not d.transient, "Config contains a transient control: " .. key)
            if d.kind == "color" then
                assert(type(value) == "table" and value.type == "Color3" and type(value.hex) == "string"
                    and value.hex:match("^%x%x%x%x%x%x$"), "Invalid color for: " .. key)
                value = Color3.fromHex(value.hex)
            end
            pending[key] = normalizeValue(d, value)
        end
        local theme, keybind
        if data.theme ~= nil then
            assert(type(data.theme) == "table", "Invalid config theme")
            theme = {}
            for name, hex in pairs(data.theme) do
                assert(C[name] and type(hex) == "string" and hex:match("^%x%x%x%x%x%x$"), "Invalid theme token: " .. tostring(name))
                theme[name] = Color3.fromHex(hex)
            end
            theme.accent = pending.customAccent or theme.accent
            theme.bg = pending.menuBackground or theme.bg
            for name, key in pairs(customization.themeKeys or {}) do theme[name] = pending[key] or theme[name] end
        end
        if data.keybind ~= nil then
            assert(type(data.keybind) == "string", "Invalid config keybind")
            local valid, candidate = pcall(function() return Enum.KeyCode[data.keybind] end)
            assert(valid and typeof(candidate) == "EnumItem" and candidate.EnumType == Enum.KeyCode, "Invalid config keybind")
            keybind = candidate
        end
        local layout = data.layout ~= nil and customization:CheckLayout(data.layout) or nil
        -- Stage every value before hooks/callbacks: they observe one coherent config.
        batching = true; table.clear(batchedKeys)
        for key, value in pairs(pending) do
            if not sameValue(api.State[key], value) then api.State[key] = copyValue(value); batchedKeys[key] = true end
        end
        if theme then self:SetTheme(theme) end
        for _, d in ipairs(defs) do
            if batchedKeys[d.key] then for _, sync in ipairs(syncs[d.key]) do sync(true) end end
        end
        for _, d in ipairs(defs) do
            if batchedKeys[d.key] and not d.callback and not (d.key == "accent" and pending.customAccent ~= nil) then callHook(d.key) end
        end
        if keybind then self:SetKeybind(keybind) end
        if layout then self:SetLayout(layout) end
        local notifications = {}
        for _, d in ipairs(defs) do if batchedKeys[d.key] then notifications[#notifications + 1] = d.key end end
        batching = false; table.clear(batchedKeys)
        for _, key in ipairs(notifications) do
            if byKey[key].callback then callHook(key) end
            changed:Fire(key, copyValue(self.State[key]))
        end
    end)
    batching = false; table.clear(batchedKeys)
    return ok, ok and "Config loaded" or tostring(result)
end
local sessionConfigs = {}
local configBytes = 0
local configBudget = 2097152
local function configName(name)
    assert(type(name) == "string", "Config name must be text")
    name = name:match("^%s*(.-)%s*$")
    assert(utf8.len(name) and #name > 0 and #name <= 64 and not name:find("[%z\1-\31]"), "Use a name of 1–64 bytes without control characters")
    return name
end
function api:ListConfigs()
    local names = {}
    for name in pairs(sessionConfigs) do names[#names + 1] = name end
    table.sort(names)
    return names
end
function api:SaveConfig(name)
    assert(not destroyed and not unloading, "Menu is unavailable")
    name = configName(name)
    assert(sessionConfigs[name] or #self:ListConfigs() < 32, "A session can contain up to 32 configs")
    local json = self:ExportConfig()
    local nextSize = configBytes - #(sessionConfigs[name] or "") + #json
    if nextSize > configBudget then return false, "Session config budget is 2 MiB; delete or export an old profile" end
    sessionConfigs[name] = json; configBytes = nextSize
    self:SetOptions("configProfile", self:ListConfigs())
    self:Set("configProfile", name)
    return true
end
function api:LoadConfig(name)
    local json = sessionConfigs[configName(name)]
    if not json then return false, "Config not found" end
    return self:ImportConfig(json)
end
function api:DeleteConfig(name)
    if destroyed or unloading then return false, "Menu is unavailable" end
    name = configName(name)
    if not sessionConfigs[name] then return false, "Config not found" end
    configBytes = configBytes - #sessionConfigs[name]
    sessionConfigs[name] = nil
    self:SetOptions("configProfile", self:ListConfigs())
    return true
end

-- Reusable element API. All controls also appear in search unless opted out.
function api:AddControl(kind, options, column, host)
    assert(not destroyed and not unloading, "Menu is unavailable")
    assert(type(options) == "table" and controls[kind], "Unknown control kind")
    column = column or 1
    assert(column == 1 or column == 2, "Column must be 1 or 2")
    local d = copyValue(options)
    d.kind = kind
    d.key = d.key or ("custom_" .. kind .. "_" .. (#defs + 1))
    d.text = d.text or kind
    if kind == "dropdown" or kind == "multidropdown" or kind == "select" then
        d.options = d.options or {}
        assert(type(d.options) == "table", "Options must be an array")
        local used, count = {}, 0
        for index in pairs(d.options) do
            assert(type(index) == "number" and index > 0 and index % 1 == 0, "Options must be a dense array")
            count = count + 1
        end
        for i = 1, count do assert(d.options[i] ~= nil, "Options must be a dense array") end
        for index, option in ipairs(d.options) do
            assert(type(option) == "string" and not used[option], "Options must be unique strings")
            used[option] = true
            assert(index <= 100, "Use at most 100 options")
        end
        assert(kind ~= "select" or #d.options > 0, "Select requires options")
        if d.value == nil then d.value = kind == "multidropdown" and {} or d.options[1] or "" end
    elseif kind == "color" then
        d.value = d.value or C.accent
    elseif kind == "input" then
        d.value = d.value or ""
        d.maxLength = d.maxLength or 1024
        assert(type(d.maxLength) == "number" and d.maxLength > 0 and d.maxLength <= 131072 and d.maxLength % 1 == 0, "Invalid input length limit")
    elseif kind == "label" then
        d.value = d.value or d.text
        d.transient = true
    elseif kind == "button" then
        d.value = 0; d.transient = true
    elseif kind == "toggle" then
        if d.value == nil then d.value = false end
        assert(type(d.value) == "boolean", "Toggle value must be boolean")
    elseif kind == "slider" then
        assert(type(d.min) == "number" and type(d.max) == "number" and math.abs(d.min) < math.huge and math.abs(d.max) < math.huge and d.max > d.min, "Slider needs finite min < max")
        d.step = d.step or 1
        assert(type(d.step) == "number" and d.step > 0 and d.step < math.huge, "Slider step must be finite and positive")
        d.value = d.value or d.min
        assert(type(d.value) == "number", "Slider value must be a number")
    elseif kind == "swatch" then
        assert(type(d.colors) == "table" and #d.colors > 0, "Swatch requires colors")
        d.value = d.value or 1
    end
    if d.height then assert(type(d.height) == "number" and d.height >= 48 and d.height <= 240, "Height must be 48..240") end
    assert(d.callback == nil or type(d.callback) == "function", "Callback must be a function")
    d.value = normalizeValue(d, d.value)
    def(d)
    if d.callback and kind ~= "button" then hooks[d.key] = function(value) d.callback(value, api) end end
    local targetColumn = options.tab == "settings" and settingsPage.columns[column] or elementColumns[column]
    local frame = controls[kind](host or targetColumn, d)
    if #search.Text >= 2 then showDesired(1) end
    local replicas = {frame}
    if resultItems[d.key] then
        for _, child in ipairs(resultItems[d.key]:GetChildren()) do if child:IsA("GuiObject") then replicas[#replicas + 1] = child; break end end
    end
    d.frames = replicas
    local handle = {Frame = frame, Key = d.key}
    function handle:Get() return api:Get(d.key) end
    function handle:Set(value) api:Set(d.key, value); return self end
    function handle:SetText(value)
        assert(kind == "label" or kind == "input", "SetText requires a label or input")
        return self:Set(value)
    end
    function handle:SetOptions(value) api:SetOptions(d.key, value); return self end
    function handle:OnChanged(callback)
        assert(type(callback) == "function", "OnChanged requires a callback")
        return (instanceScopes[frame] or rootScope):Connect(api.Changed, function(key, value)
            if key == d.key then
                local ok, message = pcall(callback, copyValue(value))
                if not ok then warn("Source UI OnChanged (" .. key .. "): " .. tostring(message)) end
            end
        end)
    end
    local attachedColor, settingsPanel
    local function arrangeAccessories()
        for _, replica in ipairs(replicas) do
        local caption = replica:FindFirstChild("Label")
        if caption then
        if kind == "toggle" then
            local left = attachedColor and attachedColor.Side == "left" and 46 or 14
            local right = settingsPanel and 162 or 186
            if attachedColor and attachedColor.Side == "right" then right = 132 end
            caption.Position = UDim2.fromOffset(left, 0)
            caption.Size = UDim2.fromOffset(right - left, 38)
        else
            caption.Size = UDim2.fromOffset(kind == "slider" and 100 or 180, caption.Size.Y.Offset)
            if kind == "slider" then
                local number = replica:FindFirstChild("Value")
                if number then number.Size = UDim2.fromOffset(78, number.Size.Y.Offset) end
            end
        end
        caption.TextTruncate = Enum.TextTruncate.AtEnd
        end
        end
    end
    function handle:AddColorPicker(options, side)
        assert(kind == "toggle", "Inline color requires a toggle")
        assert(not attachedColor, "This toggle already has a color picker")
        side = side or "left"
        assert(side == "left" or side == "right", "Color side must be left or right")
        local config = copyValue(options or {})
        config.key = config.key or d.key .. "_color"
        config.text = config.text or d.text .. " color"
        config.inline = true; config.searchable = false
        attachedColor = api:AddControl("color", config, 1, frame)
        attachedColor.Side = side
        attachedColor.Frame.Position = UDim2.fromOffset(side == "left" and 14 or 136, 7)
        attachedColor.Frame.ZIndex = 5
        for i = 2, #replicas do
            local mirror = controls.color(replicas[i], byKey[attachedColor.Key])
            mirror.Position = attachedColor.Frame.Position; mirror.ZIndex = 5
            table.insert(byKey[attachedColor.Key].frames, mirror)
        end
        handle.Color = attachedColor
        arrangeAccessories()
        return attachedColor
    end
    function handle:AddSettings(options)
        assert(not settingsPanel, "This control already has mini settings")
        settingsPanel = api:CreateMiniSettings(frame, options or {title = d.text})
        for _, replica in ipairs(replicas) do
        local gear = hit(replica, "MiniSettings", kind == "toggle" and 164 or 206, 7, 24, 24)
        gear.ZIndex = 6
        local glyph = icon(gear, "settings", 4, 4, 16, C.inactive)
        connect(gear.MouseEnter, function() tween(glyph, 0.16, {ImageColor3 = C.accent, Rotation = 30}) end)
        connect(gear.MouseLeave, function() tween(glyph, 0.16, {ImageColor3 = C.inactive, Rotation = 0}) end)
        connect(gear.Activated, function() settingsPanel:Toggle(replica) end)
        end
        handle.Settings = settingsPanel
        arrangeAccessories()
        return settingsPanel
    end
    d.decorate = function(replica)
        replicas[#replicas + 1] = replica
        if attachedColor then
            local mirror = controls.color(replica, byKey[attachedColor.Key])
            mirror.Position = attachedColor.Frame.Position; mirror.ZIndex = 5
            table.insert(byKey[attachedColor.Key].frames, mirror)
        end
        if settingsPanel then
            local gear = hit(replica, "MiniSettings", kind == "toggle" and 164 or 206, 7, 24, 24)
            gear.ZIndex = 6
            local glyph = icon(gear, "settings", 4, 4, 16, C.inactive)
            -- Use the replica owner, so evicting a search row releases its listeners.
            local owner = instanceScopes[replica]
            owner:Connect(gear.MouseEnter, function() tween(glyph, 0.16, {ImageColor3=C.accent, Rotation=30}) end)
            owner:Connect(gear.MouseLeave, function() tween(glyph, 0.16, {ImageColor3=C.inactive, Rotation=0}) end)
            owner:Connect(gear.Activated, function() settingsPanel:Toggle(replica) end)
        end
        arrangeAccessories()
    end
    if options.color then handle.Color = handle:AddColorPicker(options.color, options.colorSide) end
    if options.settings then
        handle.Settings = handle:AddSettings({title = options.settingsTitle or d.text})
        for _, control in ipairs(options.settings) do handle.Settings:AddControl(control.kind, control) end
    end
    function handle:SetVisible(value)
        d.hidden = value ~= true
        for _, replica in ipairs(replicas) do replica.Visible = value == true end
        if d.hidden then closePopup(); closeMini() end
        if #search.Text >= 2 then showDesired(1) end
        return self
    end
    return handle
end
