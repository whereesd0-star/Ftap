function customization:Contains(item, point)
    local pos, size = item.AbsolutePosition, item.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end
function customization:Matches(input, ending)
    local gesture = self.gesture
    if not gesture then return false end
    if gesture.input.UserInputType == Enum.UserInputType.Touch then return input == gesture.input end
    return input.UserInputType == (ending and Enum.UserInputType.MouseButton1 or Enum.UserInputType.MouseMovement)
end
function customization:CancelDrag()
    self.gesture = nil
    dragShield.Visible = false
    tween(fabScale, 0.15, {Scale=1})
end
function customization:BeginDrag(kind, input)
    if destroyed or unloading or self.gesture or activeSlider or activePicker or Input:GetFocusedTextBox() then return end
    if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
    if kind == "window" then
        if not api.Open or winVeil.Visible or veil.Visible or popup.current or activeMini or not api.State.menuDraggable then return end
        if not self:Contains(header, input.Position) or self:Contains(search, input.Position) then return end
        if api.State.menuDragMode == "Handle" and not self:Contains(dragHandle, input.Position) then return end
    elseif not fab.Visible or winVeil.Visible or popup.current or activeMini then
        return
    end
    local target = kind == "window" and root or fab
    local position, size = target.Position, gui.AbsoluteSize
    self.gesture = {kind=kind, input=input, x=input.Position.X, y=input.Position.Y,
        origin=Vector2.new(position.X.Scale * size.X + position.X.Offset, position.Y.Scale * size.Y + position.Y.Offset),
        threshold=math.max(api.State.menuDragThreshold, input.UserInputType == Enum.UserInputType.Touch and 10 or 0), moved=false}
end
function customization:MoveDrag(input)
    if not self:Matches(input, false) then return end
    local g = self.gesture
    local dx, dy = input.Position.X - g.x, input.Position.Y - g.y
    if not g.moved and dx * dx + dy * dy < g.threshold * g.threshold then return end
    g.moved = true
    if g.kind == "floating" and api.State.menuFloatingLocked then return end
    if not g.started then
        g.started = true
        positionFollowers[g.kind == "window" and root or fab] = nil
        if g.kind == "window" then dragShield.Visible = true else tween(fabScale, 0.1, {Scale=0.96}) end
    end
    local size = gui.AbsoluteSize
    if g.kind == "window" then
        local halfX = math.min(root.AbsoluteSize.X * 0.5 + 12, size.X * 0.5)
        local halfY = math.min(root.AbsoluteSize.Y * 0.5 + 12, size.Y * 0.5)
        local x = math.clamp(g.origin.X + dx, halfX, math.max(halfX, size.X - halfX))
        local y = math.clamp(g.origin.Y + dy, halfY, math.max(halfY, size.Y - halfY))
        homePos = UDim2.fromScale(x / math.max(size.X, 1), y / math.max(size.Y, 1))
        followPosition(root, UDim2.fromOffset(x, y))
    else
        local factor = api.State.menuFloatingSize / 100
        followPosition(fab, UDim2.fromOffset(
            math.clamp(g.origin.X + dx, 0, math.max(0, size.X - 36 * factor)),
            math.clamp(g.origin.Y + dy, 0, math.max(0, size.Y - 40 * factor))))
    end
end
function customization:EndDrag(input)
    if not self:Matches(input, true) then return end
    local g = self.gesture
    local dx, dy = input.Position.X - g.x, input.Position.Y - g.y
    local tap = not g.moved and dx * dx + dy * dy < g.threshold * g.threshold
    self:CancelDrag()
    if g.kind == "floating" and tap and self:Contains(fab, input.Position) then api:SetOpen(not api.Open) end
end
