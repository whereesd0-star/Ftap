controls.slider = function(container, d)
    local frame = row(container, 52)
    label(frame, "Label", d.text, 14, 6, 120, 22, labelColor, 14)
    local valueLabel = useAccent(label(frame, "Value", "", 120, 6, 108, 22, C.accent, 13), "TextColor3")
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    local track = rect(frame, "Track", 14, 38, 214, 6, C.box, "full")
    local fill = useAccent(rect(track, "Fill", 0, 0, 0, 6, C.accent, "full"))
    local knob = rect(track, "Knob", 0, 0, 14, 14, C.panel, "full")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Position = UDim2.fromScale(0, 0.5)
    local ring = stroke(knob, C.accent, 0)
    ring.Thickness = 2
    useAccent(ring, "Color")
    local displayed = new("NumberValue", frame, {Name = "DisplayedValue", Value = api.State[d.key]})
    local function drawValue()
        local v = displayed.Value
        local ratio = math.clamp((v - d.min) / (d.max - d.min), 0, 1)
        valueLabel.Text = string.format("%." .. (d.decimals or 0) .. "f", v) .. (d.suffix or "")
        fill.Size = UDim2.fromScale(ratio, 1)
        knob.Position = UDim2.fromScale(ratio, 0.5)
    end
    connect(displayed.Changed, drawValue)
    local function sync(animated)
        tween(displayed, animated and 0.14 or 0, {Value = api.State[d.key]})
        if not animated then drawValue() end
    end
    registerSync(d.key, sync)
    sync(false)
    local function fromX(x, gx, gw)
        local w = gw or track.AbsoluteSize.X
        if w <= 0 then return end
        local t = math.clamp((x - (gx or track.AbsolutePosition.X)) / w, 0, 1)
        local v = d.min + t * (d.max - d.min)
        v = math.floor(v / d.step + 0.5) * d.step
        v = tonumber(string.format("%.4f", math.clamp(v, d.min, d.max)))
        api:Set(d.key, v)
    end
    local button = hit(frame, "Hit", 0, 0, 242, 52)
    connect(button.InputBegan, function(input)
        if customization.gesture or activeSlider or activePicker then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            local gx, gw = track.AbsolutePosition.X, track.AbsoluteSize.X
            activeSlider = {fromX = fromX, knob = knob, input = input, gx = gx, gw = gw}
            tween(knob, 0.12, {Size = UDim2.fromOffset(16, 16)})
            fromX(input.Position.X, gx, gw)
        end
    end)
    hoverRow(frame, button)
    return frame
end

