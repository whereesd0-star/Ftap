end
local renderConnection
ensureRender = function()
    if renderConnection or destroyed or rootScope.disposed then return end
    renderConnection = rootScope:Connect(RunService.RenderStepped, function(dt)
    if destroyed then return end
    local alpha = customization.dragSmoothness == 0 and 1 or 1 - math.exp(-dt / (customization.dragSmoothness / 1000))
    for inst, target in pairs(positionFollowers) do
        if not inst.Parent then
            positionFollowers[inst] = nil
        else
            local position = inst.Position:Lerp(target, alpha)
            local error = math.abs(position.X.Offset - target.X.Offset) + math.abs(position.Y.Offset - target.Y.Offset)
                + 1000 * (math.abs(position.X.Scale - target.X.Scale) + math.abs(position.Y.Scale - target.Y.Scale))
            if error < 0.05 then
                inst.Position = target
                positionFollowers[inst] = nil
            else
                inst.Position = position
            end
        end
    end
    for item in pairs(dirtyScopes) do dirtyScopes[item] = nil; renderTree(item) end
    for item in pairs(dirtyVisuals) do dirtyVisuals[item] = nil; renderVisual(item) end
    if not next(positionFollowers) and not next(dirtyScopes) and not next(dirtyVisuals) then
        rootScope:Disconnect(renderConnection); renderConnection = nil
    end
    end)
end
